# ============================================================================
# AI Gateway 配置文件模板
# ============================================================================
#
# 使用方式：
#   1. 复制本文件为 config.yaml
#   2. 按需修改各参数
#   3. 支持 ${ENV_VAR} 语法引用环境变量，如 ${AGNES_API_KEY}
#   4. 支持默认值语法 ${ENV_VAR:-default_value}
#   5. 所有部署相关参数应在本文件中显式声明
#
# 环境变量覆盖：
#   任何配置项都可通过 AI_GATEWAY_<PATH> 环境变量覆盖
#   例如：AI_GATEWAY_SERVER_PORT=9000 → server.port = 9000
#
# ============================================================================

# ==========================
# 服务器配置
# ==========================
server:
  host: 0.0.0.0              # 监听地址（0.0.0.0 表示所有网卡）
  port: 8000                 # 监听端口（1024-65535）
  request_timeout_seconds: 120 # 整条请求链硬 deadline（含插件、重试、上游）
  cors_origins:              # CORS 允许的来源列表
    - http://localhost:3000
    - http://localhost:5173

# 插件统一执行隔离；单个 plugins[] 条目可用 timeout_seconds / failure_policy 覆盖。
plugin_runtime:
  default_timeout_seconds: 30
  default_failure_policy: continue # continue | fail_fast
  plugins:
    draft_generator:
      timeout_seconds: 110   # 单插件覆盖，须小于 request_timeout_seconds

# Gateway 是唯一重试所有者；LiteLLM Router/provider 内层重试已关闭。
retry_budget:
  max_attempts: 3            # 含首次调用的总尝试次数
  max_time_seconds: 30       # 所有尝试和退避共享的时间预算
  max_fallback: 1            # 单请求最多切换的 fallback 模型数

# ==========================
# 认证与配额
# ==========================
auth:
  api_keys:                  # API Key 列表（启动时导入 Redis）
    - key: ${ADMIN_API_KEY:-}
      user_id: admin         # 关联的用户 ID
      scopes: [admin, chat, embedding]  # 显式权限范围
      expires_at: null       # ISO-8601；生产环境建议设置并定期 rotate
      group: admin-team      # 可选: API Key 分组标签（用于成本追踪指标聚合，不影响资源隔离）
      quotas:                # 该 Key 的配额限制
        daily_tokens: 1000000      # 每日 token 上限
        monthly_cost: 50.0         # 每月成本上限（美元）
        rate_limit_rpm: 60         # 每分钟请求数上限 (RPM)
        rate_limit_tpm: 100000     # 每分钟 token 数上限 (TPM)

  distributed_mode: false    # 分布式模式（多实例时通过 Pub/Sub 同步 Key 变更）

  defaults:                  # 新建 API Key 时的默认配额
    daily_tokens: 1000000    # 默认日 token 上限
    monthly_cost: 50.0       # 默认月成本上限（美元）
    rate_limit_rpm: 60       # 默认 RPM
    rate_limit_tpm: 100000   # 默认 TPM

  budget_alert_threshold: 0.8  # 配额预警阈值（0.8 = 使用达 80% 时触发告警）

# ==========================
# 插件配置
# ==========================
# 插件按定义顺序执行，可通过 depends_on 声明依赖关系
plugins:
  - name: pii_detector       # PII 检测器（个人信息脱敏）
    enabled: true
    depends_on: []
    config:
      strategy: sanitize     # 策略：sanitize(脱敏) | reject(拒绝) | warn(仅告警)

  - name: prompt_cache       # 提示词精确缓存（L1/L2 查询入口）
    enabled: true
    depends_on: []
    config: {}

  - name: semantic_cache     # 语义缓存（L3 向量相似度匹配）
    enabled: true
    depends_on:
      - prompt_cache         # 在 prompt_cache miss 后才执行语义匹配
    config:
      embedding_model: Qwen/Qwen3-Embedding-0.6B  # 嵌入模型名
      threshold: 0.95        # 语义相似度阈值（0-1，越高越严格）
      ttl: 86400             # 语义缓存条目 TTL（秒），默认 24h
      rerank:                # Rerank 二次精排配置
        enabled: false       # 是否启用 rerank
        backend: lightweight # 后端：lightweight | cross-encoder
        retrieve_top_k: 5    # 初筛返回 top-K 候选
        retrieve_threshold: 0.9   # 初筛最低相似度
        rerank_threshold: 0.85    # 精排接受阈值

  - name: prompt_compress    # 提示词压缩（减少 token 消耗）
    enabled: true
    depends_on: ["semantic_cache"]
    config:
      compression_ratio: 0.5 # 目标压缩比（0.5 = 压缩到 50%）
      model_name: "microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank" # LLMLingua 模型名
      target_token: -1       # 目标 token 数，-1 表示按 compression_ratio 自动
      device: cuda           # 运行设备：cpu | cuda | auto（auto=有CUDA用CUDA）

  - name: rag_retriever      # RAG 检索增强（知识库检索）
    enabled: false           # 默认关闭，需配合 Qdrant 知识库
    depends_on: ["semantic_cache"]
    config:
      top_k: 5              # 检索返回 top-K 文档块
      similarity_threshold: 0.7  # 相似度阈值
      rerank_enabled: false  # 是否启用重排序
      rerank_device: auto    # 启用时由套餐固定为 cuda / mps，不静默回 CPU
      rerank_backend: local  # local | remote（Apple 原生服务使用 remote）
      rerank_api_base:
      rerank_api_key:
      chunk_size: 512        # 文档分块大小（token）
      chunk_overlap: 64      # 分块重叠
      collection_name: rag_documents  # Qdrant 集合名称
      embedding_backend: local  # local | openai（Apple/remote 由安装器生成）
      embedding_model: Qwen/Qwen3-Embedding-0.6B # RAG 查询向量模型
      embedding_device: auto    # 套餐配置固定为 cuda / mps / remote，不静默回 CPU
      embedding_api_base:
      embedding_api_key:
      code_rag_enabled: true       # 是否在检索时并行查询 rag_code_* 代码集合
      code_rag_graph_hops: 2       # CodeGraph 调用图跳数（callers/callees 展开深度）
      code_rag_top_k: 5            # 代码集合检索 top-K

  - name: conv_compressor    # 对话历史压缩（长会话摘要）
    enabled: false           # 默认关闭，需安装 langchain
    depends_on: ["semantic_cache"]
    config:
      max_history: 20        # 保留最近 N 条消息，超出部分压缩为摘要
      summary_model: gpt-4o-mini  # 摘要生成使用的模型
      max_token_limit: 4000  # 摘要最大 token 数
      summary_interval: 5    # 每 N 条消息触发一次摘要
      api_base: http://localhost:8000/v1 # 内部 OpenAI 兼容 API 地址
      api_key: ${CONV_COMPRESSOR_API_KEY:-} # 摘要调用凭据

# ==========================
# 模型提供商配置
# ==========================
providers:
  agnes:
    api_key: ${AGNES_API_KEY}
    base_url: https://apihub.agnes-ai.com/v1
    timeout: 120
    num_retries: 3
    retry_after: 1000
    model_grouper:
      - models:
          - name: agnes-2.0-flash
            capabilities: [text, image, video]
            tasks: [general, summary, vision]
            features: [vision, tool_calling, structured_output, long_context]
          - name: agnes-image-2.1-flash
            capabilities: [image]
          - name: agnes-video-v2.0
            capabilities: [video]
        fallback_models: []
        pricing:
          agnes-2.0-flash:
            prompt: 0.02
            completion: 1

  deepseek:
    api_key: ${DEEPSEEK_API_KEY}
    base_url: https://api.deepseek.com/v1
    timeout: 120
    num_retries: 3
    retry_after: 1000
    model_grouper:
      - models:
          - name: deepseek-v4-flash
            capabilities: [text]
            tasks: [coding, reasoning, general]
            features: [tool_calling, structured_output, long_context]
        fallback_models: []
        pricing:
          deepseek-v4-flash:
            prompt: 0.02
            completion: 1

# ==========================
# 向量嵌入配置
# ==========================
embedding:
  backend: sentence_transformers  # 后端引擎：sentence_transformers | openai | litellm
  model: Qwen/Qwen3-Embedding-0.6B  # 嵌入模型名称
  vector_dim: 1024           # 向量维度（必须与模型输出维度一致）
  openai_model: text-embedding-3-small  # OpenAI 后端回退时使用的模型
  device: auto               # L3 向量计算设备：cpu | cuda | auto（auto=有CUDA用CUDA）

# ==========================
# 可观测性配置
# ==========================
observability:
  prometheus_enabled: true   # 是否启用 Prometheus /metrics 端点
  opentelemetry_enabled: true  # 是否启用 OpenTelemetry 链路追踪
  otel_service_name: ai-gateway  # OTEL 服务名称
  otel_sample_rate: 0.1      # OTEL 采样率（0.1 = 10% 请求生成 trace）
  log_format: json           # 日志格式：json | text
  log_level: info            # 日志级别：debug | info | warning | error

# ==========================
# 基础设施连接
# ==========================
infrastructure:
  redis:
    url: ${AI_GATEWAY_REDIS_URL:-redis://localhost:6379/0}  # Redis 连接 URL
    namespace: ai-gateway    # Redis Key 命名空间；共享 Redis 时应按实例设置不同值
    connect_timeout: 5       # 连接超时（秒）
    socket_timeout: 10       # 读写超时（秒）
    health_check_interval: 30  # 健康检查间隔（秒）
    rpm_key_ttl: 120         # RPM 滑动窗口 sorted set TTL（秒）
    tpm_window_ttl: 60       # TPM 计数器窗口 TTL（秒）

  qdrant:
    url: ${AI_GATEWAY_QDRANT_URL:-http://localhost:6333}  # Qdrant REST API 地址
    connect_timeout: 5.0     # HTTP 连接超时（秒）
    read_timeout: 10.0       # HTTP 读取超时（秒）
    write_timeout: 10.0      # HTTP 写入超时（秒）
    hnsw_m: 16               # HNSW 索引参数 M（影响召回率和内存）
    hnsw_ef_construct: 128   # HNSW 构建时 ef 值（越大索引越准但越慢）

# ==========================
# 缓存配置
# ==========================
cache:
  pipeline_version: "2"      # 管道语义变化时递增，强制失效旧响应
  l1:
    max_entries: 1000        # 最大条目数（LRU 淘汰）
    max_value_bytes: 102400  # 单条最大字节数（100KB），超过不进 L1
  l2:
    max_value_bytes: 512000
    default_ttl: 3600
    bm25:
      enabled: true
      min_score: 1.5
      top_k: 5
  l3:
    min_token_count: 100
    default_ttl: 86400
    cleanup_interval: 3600
    similarity_threshold: 0.95
    rerank:
      enabled: false
      model: cross-encoder/ms-marco-MiniLM-L-6-v2
      retrieve_top_k: 5
      retrieve_threshold: 0.90
      rerank_threshold: 0.85

circuit_breaker:
  failure_threshold: 5
  recovery_timeout: 60
  long_open_alert_seconds: 300

rate_limiter:
  max_requests: 30
  window_seconds: 60

streaming:
  cache_chunk_delay_ms: 20
  cache_chunk_count: 20

code_rag:
  enabled: true
  allowed_server_paths:
    - /home/ubuntu
    - /workspace
  max_file_size_mb: 5
  max_total_size_mb: 200
  max_file_count: 5000
  ignore_patterns:
    - node_modules
    - .git
    - __pycache__
    - dist
    - build
  graph_db_dir: /data/code_graphs  # CodeGraph SQLite 图谱库存放目录

hot_reload: true

debug:
  frontend: false
  entry: false
  cache: false
  bridge: false
  plugins:
    enabled: false
    per_plugin:
      pii_detector: false
      prompt_cache: false
      semantic_cache: false
      rag_retriever: false
      conv_compressor: false
      media_optimizer: false
      ai_director: false
      intent_evaluator: false
      token_compressor: false
      draft_generator: false
      gen_model_router: false
      cost_tracker: false

media_optimization:
  enabled: true
  download_timeouts:
    image: 30
    video: 120
    audio: 60
    document: 60
  image:
    max_width: 1920
    max_height: 1080
    quality: 85
    output_format: webp
    ocr_backend: tesseract
    ocr_languages: [eng, chi_sim]
    caption_model: agnes-2.0-flash
    max_file_size_mb: 20.0
    caption_max_tokens: 150
    caption_temperature: 0.3
    paddleocr:
      lang: ch
      use_angle_cls: true
  video:
    max_frames: 10
    frame_interval_sec: 5.0
    scene_detection: true
    target_resolution: 720p
    max_duration_sec: 300
    whisper_model: faster-whisper
    language: auto
    max_file_size_mb: 100.0
  audio:
    target_format: opus
    sample_rate: 16000
    bitrate: 64k
    whisper_model: faster-whisper
    language: auto
    max_duration_sec: 600
    diarization_enabled: false
    max_file_size_mb: 50.0
    whisper_model_size: base
  document:
    supported_formats: [pdf, docx, xlsx, pptx, md, csv, html]
    ocr_fallback: true
    chunk_size: 512
    chunk_overlap: 64
    chunking_strategy: semantic
    embedding_model: Qwen/Qwen3-Embedding-0.6B
    vector_dim: 1024
    summary_max_length: 500
    max_file_size_mb: 50.0
    long_doc_threshold_chars: 5000
    summary_preview_chars: 2000
    unstructured:
      strategy: auto
      languages: ["chi_sim", "eng"]
      extract_images: false
  generation:
    enhancement_level: 'off'
    vision_model: agnes-2.0-flash
    default_model: agnes-2.0-flash
    max_retries: 3
    retry_delay_ms: 1000
  media_cache_ttl: 604800
  max_concurrent_processors: 4

# ==========================
# 生成优化层配置
# ==========================
generation_optimization:
  ai_director: {}
  model_router: {}
  feature_cache: {}
  cost_tracking: {}
  prompt_templates: {}
  token_compressor:
    clip:
      model_name: "openai/clip-vit-large-patch14" # CLIP 模型名称
      device: cpu
      batch_size: 1
  draft_workflow:
    store_dir: /app/data/drafts # Gateway 草稿/预览/结果的持久化根目录
    retention_period_hours: 24 # 草稿文件与会话目录的保留时长（小时）
    comfyui:
      server_url: "http://comfyui:8188"
      public_url: "http://localhost:8188"
      manager_enabled: true
      connect_timeout: 10
      execution_timeout: 1200
      required: true
      workflow_version: "image-v1"
      checkpoint_name: "sd_xl_base_1.0.safetensors"
      allowed_checkpoints: ["sd_xl_base_1.0.safetensors"]
      max_concurrency: 1
      min_free_gb: 30
      model_budget_gb: 80
      output_budget_gb: 10
      output_retention_hours: 24
      models_path: "/comfyui/models"
      output_path: "/comfyui/output"
      workflow_path: "/comfyui/workflows"
      upscale_enabled: true
      upscale_model: "RealESRGAN_x4plus.pth"
      allowed_upscale_models: ["RealESRGAN_x4plus.pth"]
      max_upscale_long_edge: 4096
      qwen_image_enabled: true
      qwen_image_diffusion_model: "qwen_image_fp8_e4m3fn.safetensors"
      qwen_image_text_encoder: "qwen_2.5_vl_7b_fp8_scaled.safetensors"
      qwen_image_vae: "qwen_image_vae.safetensors"
      qwen_image_draft_steps: 12
      qwen_image_max_draft_edge: 768
      allowed_qwen_image_diffusion_models: ["qwen_image_fp8_e4m3fn.safetensors"]
      allowed_qwen_image_text_encoders: ["qwen_2.5_vl_7b_fp8_scaled.safetensors"]
      allowed_qwen_image_vaes: ["qwen_image_vae.safetensors"]
      video_enabled: true
      video_workflow_version: "wan2.2-ti2v-5b-v1"
      video_diffusion_model: "wan2.2_ti2v_5B_fp16.safetensors"
      video_text_encoder: "umt5_xxl_fp8_e4m3fn_scaled.safetensors"
      video_vae: "wan2.2_vae.safetensors"
      allowed_video_diffusion_models: ["wan2.2_ti2v_5B_fp16.safetensors"]
      allowed_video_text_encoders: ["umt5_xxl_fp8_e4m3fn_scaled.safetensors"]
      allowed_video_vaes: ["wan2.2_vae.safetensors"]
      video_width: 512
      video_height: 288
      video_frames: 17
      video_fps: 8
      video_steps: 20
      video_cfg: 5
      video_shift: 8
      video_execution_timeout: 1200

intent_classifier:
  model: agnes-2.0-flash
  timeout_seconds: 2
  fallback: heuristic
  fast_path_enabled: true
  fast_path_confidence: 0.8
  cache_ttl_seconds: 300
  cache_max_entries: 1024

model_selector:
  health_check_interval: 60
  latency_weight: 0.4
  cost_weight: 0.2
  success_rate_weight: 0.4

task_routing:
  enabled: true
  version: "2"
  min_confidence: 0.6
  model_selection_mode: policy
  expose_debug_metadata: false
  model_preferences:
    coding: [deepseek-v4-flash]
    reasoning: [deepseek-v4-flash]
    summary: [agnes-2.0-flash]
    vision: [agnes-2.0-flash]
    general: [agnes-2.0-flash]

generation:
  image:
    default_size: "1024x1024"
    response_format: "url"
    quality: "auto"
  video:
    poll_endpoint: /v1/videos/{id}
