# ============================================================================
# AI Gateway 配置文件模板
# ============================================================================
#
# 使用方式：
#   1. 复制本文件为 config.yaml
#   2. 按需修改各参数
#   3. 支持 ${ENV_VAR} 语法引用环境变量，如 ${AGNES_API_KEY}
#   4. 支持默认值语法 ${ENV_VAR:-default_value}
#   5. 所有部署相关参数应在本文件中显式声明
#
# 环境变量覆盖：
#   任何配置项都可通过 AI_GATEWAY_<PATH> 环境变量覆盖
#   例如：AI_GATEWAY_SERVER_PORT=9000 → server.port = 9000
#
# ============================================================================

# ==========================
# 服务器配置
# ==========================
server:
  host: 0.0.0.0              # 监听地址（0.0.0.0 表示所有网卡）
  port: 8000                 # 监听端口（1024-65535）
  request_timeout_seconds: 120 # 整条请求链硬 deadline（含插件、重试、上游）
  cors_origins:              # CORS 允许的来源列表
    - http://localhost:3000
    - http://localhost:5173

plugin_runtime:
  default_timeout_seconds: 30 # 插件默认执行超时（秒）
  default_failure_policy: continue # 插件失败策略：continue | fail_fast
  plugins:
    draft_generator:
      timeout_seconds: 110   # 单插件覆盖，须小于 request_timeout_seconds

retry_budget:
  max_attempts: 3            # 含首次调用的总尝试次数
  max_time_seconds: 30       # 所有尝试和退避共享的时间预算
  max_fallback: 1            # 单请求最多切换的 fallback 模型数

# ==========================
# 认证与配额
# ==========================
auth:
  database_path: /app/data/auth.db # API Key、配额、分组和成本账本 SQLite 文件路径
  database_timeout_seconds: 30 # SQLite 获取文件锁的等待超时（秒）
  admin_username: admin      # 首次初始化控制台管理员时使用的登录名
  admin_user_id: admin       # 管理员在 SQLite 和审计记录中的稳定用户 ID
  session:
    idle_ttl_seconds: 28800  # 浏览器 Session 空闲超时（秒）
    absolute_ttl_seconds: 86400 # 浏览器 Session 最长存活时间（秒）
  password:
    pbkdf2_iterations: 600000 # 管理员密码 PBKDF2-SHA256 迭代次数
  api_keys:                  # API Key 列表（首次启动时导入 SQLite）
    - key: ${ADMIN_API_KEY:-}
      user_id: admin         # 关联的用户 ID
      scopes: [admin, chat, embedding] # 权限范围
      expires_at: null       # ISO-8601；为空表示不过期
      group: admin-team      # API Key 分组
      quotas:
        daily_tokens: 1000000 # 每日 token 上限
        monthly_cost: 50.0   # 每月成本上限（美元）
        rate_limit_rpm: 60   # 每分钟请求数
        rate_limit_tpm: 100000 # 每分钟 token 数
  distributed_mode: false    # 多实例配置同步开关
  defaults:
    daily_tokens: 1000000    # 新建 Key 默认日 token 上限
    monthly_cost: 50.0       # 新建 Key 默认月成本上限
    rate_limit_rpm: 60       # 新建 Key 默认 RPM
    rate_limit_tpm: 100000   # 新建 Key 默认 TPM
  budget_alert_threshold: 0.8 # 配额使用率预警阈值

# ==========================
# 插件配置
# ==========================
plugins:
  - name: pii_detector       # PII 检测器
    enabled: true
    depends_on: []
    config:
      strategy: sanitize     # sanitize | reject | warn
  - name: prompt_cache       # 提示词精确缓存
    enabled: true
    depends_on: []
    config: {}
  - name: semantic_cache     # 语义缓存
    enabled: true
    depends_on: [prompt_cache]
    config:
      embedding_model: Qwen/Qwen3-Embedding-0.6B # 嵌入模型
      threshold: 0.95        # 语义相似度阈值
      ttl: 86400             # 语义缓存 TTL（秒）
      rerank:
        enabled: false       # 是否启用二次精排
        backend: lightweight # lightweight | cross-encoder
        retrieve_top_k: 5    # 初筛候选数
        retrieve_threshold: 0.9 # 初筛最低相似度
        rerank_threshold: 0.85 # 精排接受阈值
  - name: prompt_compress    # 提示词压缩
    enabled: true
    depends_on: [semantic_cache]
    config:
      compression_ratio: 0.5 # 目标压缩比
      model_name: microsoft/llmlingua-2-bert-base-multilingual-cased-meetingbank # LLMLingua 模型
      target_token: -1       # -1 表示按压缩比自动计算
      device: cpu            # cpu | cuda | auto
  - name: rag_retriever      # RAG 检索增强
    enabled: false
    depends_on: [semantic_cache]
    config:
      top_k: 5               # 返回文档块数量
      similarity_threshold: 0.7 # 相似度阈值
      rerank_enabled: false  # 是否启用重排序
      rerank_model: cross-encoder/ms-marco-MiniLM-L-6-v2 # 重排序模型
      rerank_device: auto    # cpu | cuda | mps | auto
      rerank_backend: local  # local | remote
      rerank_api_base:
      rerank_api_key:
      chunk_size: 512        # 文档分块大小
      chunk_overlap: 64      # 文档分块重叠
      collection_name: rag_documents # Qdrant 集合名
      embedding_backend: local # local | openai
      embedding_model: Qwen/Qwen3-Embedding-0.6B # RAG 嵌入模型
      embedding_device: auto # 嵌入计算设备
      embedding_api_base:
      embedding_api_key:
      code_rag_enabled: true # 是否查询代码集合
      code_rag_graph_hops: 2 # CodeGraph 展开跳数
      code_rag_top_k: 5      # 代码检索候选数
  - name: conv_compressor    # 对话历史压缩
    enabled: false
    depends_on: [semantic_cache]
    config:
      max_history: 20        # 保留最近消息数
      summary_model: gpt-4o-mini # 摘要模型
      max_token_limit: 4000  # 摘要 token 上限
      summary_interval: 5    # 每 N 条消息触发摘要
      api_base: http://localhost:8000/v1 # 内部 OpenAI 兼容地址
      api_key: ${CONV_COMPRESSOR_API_KEY:-} # 内部调用凭据

# ==========================
# 模型提供商配置
# ==========================
providers:
  agnes:
    api_key: ${AGNES_API_KEY} # 提供商 API Key
    base_url: https://apihub.agnes-ai.com/v1 # 提供商 API 地址
    timeout: 120             # 请求超时（秒）
    num_retries: 3           # 请求重试次数
    retry_after: 1000        # 重试间隔（毫秒）
    model_grouper:
      - models:
          - name: agnes-2.0-flash
            capabilities: [text, image, video]
            tasks: [general, summary, vision]
            features: [vision, tool_calling, structured_output, long_context]
          - name: agnes-image-2.1-flash
            capabilities: [image]
          - name: agnes-video-v2.0
            capabilities: [video]
        fallback_models: []
        pricing:
          agnes-2.0-flash:
            prompt: 0.02     # 输入 token 单价
            completion: 1    # 输出 token 单价
  deepseek:
    api_key: ${DEEPSEEK_API_KEY}
    base_url: https://api.deepseek.com/v1
    timeout: 120
    num_retries: 3
    retry_after: 1000
    model_grouper:
      - models:
          - name: deepseek-v4-flash
            capabilities: [text]
            tasks: [coding, reasoning, general]
            features: [tool_calling, structured_output, long_context]
        fallback_models: []
        pricing:
          deepseek-v4-flash:
            prompt: 0.02
            completion: 1

# ==========================
# 向量嵌入配置
# ==========================
embedding:
  backend: sentence_transformers # sentence_transformers | openai | litellm
  model: Qwen/Qwen3-Embedding-0.6B # 嵌入模型名称
  vector_dim: 1024           # 向量维度
  openai_model: text-embedding-3-small # OpenAI 嵌入模型
  device: auto               # cpu | cuda | auto

# ==========================
# 可观测性配置
# ==========================
observability:
  prometheus_enabled: true   # 是否启用 Prometheus
  opentelemetry_enabled: true # 是否启用 OpenTelemetry
  otel_service_name: ai-gateway # 服务名称
  otel_sample_rate: 0.1      # trace 采样率
  log_format: json           # json | text
  log_level: info            # debug | info | warning | error

# ==========================
# 基础设施连接
# ==========================
infrastructure:
  redis:
    url: ${AI_GATEWAY_REDIS_URL:-redis://localhost:6379/0} # Redis 连接 URL
    namespace: ai-gateway    # Redis Key 命名空间，共享 Redis 时应保持实例唯一
    connect_timeout: 5       # Redis 连接超时（秒）
    socket_timeout: 10       # Redis 读写超时（秒）
    health_check_interval: 30 # Redis 健康检查间隔（秒）
    rpm_key_ttl: 120         # RPM 窗口 Key TTL（秒）
    tpm_window_ttl: 60       # TPM 窗口 Key TTL（秒）
  qdrant:
    url: ${AI_GATEWAY_QDRANT_URL:-http://localhost:6333} # Qdrant REST 地址
    connect_timeout: 5.0     # Qdrant 连接超时（秒）
    read_timeout: 10.0       # Qdrant 读取超时（秒）
    write_timeout: 10.0      # Qdrant 写入超时（秒）
    distance: COSINE         # 向量距离类型：COSINE | DOT | EUCLID
    hnsw_m: 16               # HNSW M 参数
    hnsw_ef_construct: 128   # HNSW ef_construct 参数

# ==========================
# 缓存配置
# ==========================
cache:
  pipeline_version: "2"     # 缓存语义版本
  key_buckets:
    max_tokens: [256, 512, 1024, 2048, 4096, 8192, 16384] # max_tokens 分桶边界
  l1:
    max_entries: 1000        # L1 最大条目数
    max_value_bytes: 102400  # L1 单条最大字节数
  l2:
    max_value_bytes: 512000  # L2 单条最大字节数
    default_ttl: 3600        # L2 默认 TTL（秒）
    bm25:
      enabled: true          # 是否启用 BM25
      min_score: 1.5         # BM25 最低分数
      top_k: 5               # BM25 候选数
  l3:
    min_token_count: 100     # 写入 L3 的最小 token 数
    default_ttl: 86400       # L3 默认 TTL（秒）
    cleanup_interval: 3600   # L3 清理间隔（秒）
    similarity_threshold: 0.95 # L3 相似度阈值
    rerank:
      enabled: false         # 是否启用 L3 精排
      model: cross-encoder/ms-marco-MiniLM-L-6-v2 # 精排模型
      retrieve_top_k: 5
      retrieve_threshold: 0.90
      rerank_threshold: 0.85

circuit_breaker:
  failure_threshold: 5       # 熔断失败阈值
  recovery_timeout: 60       # 熔断恢复等待时间（秒）
  long_open_alert_seconds: 300 # 长期开路告警阈值（秒）

rate_limiter:
  max_requests: 30           # 窗口内最大请求数
  window_seconds: 60         # 限流窗口（秒）

streaming:
  cache_chunk_delay_ms: 20   # 缓存流式 chunk 延迟（毫秒）
  cache_chunk_count: 20      # 缓存流式 chunk 数量

code_rag:
  enabled: true              # 是否启用 Code RAG
  allowed_server_paths:      # 可导入的服务器目录白名单
    - /home/ubuntu
    - /workspace
  max_file_size_mb: 5        # 单文件最大大小（MB）
  max_total_size_mb: 200     # 单次导入总大小（MB）
  max_file_count: 5000       # 单次导入文件数上限
  ignore_patterns: [node_modules, .git, __pycache__, dist, build]
  graph_db_dir: /data/code_graphs # CodeGraph SQLite 目录

hot_reload: true             # 是否启用配置热重载

debug:
  frontend: false            # 前端调试日志
  entry: false               # 入口链路调试日志
  cache: false               # 缓存调试日志
  bridge: false              # Bridge 调试日志
  plugins:
    enabled: false           # 插件调试总开关
    per_plugin:
      pii_detector: false
      prompt_cache: false
      semantic_cache: false
      rag_retriever: false
      conv_compressor: false
      media_optimizer: false
      ai_director: false
      intent_evaluator: false
      token_compressor: false
      draft_generator: false
      gen_model_router: false
      cost_tracker: false

media_optimization:
  enabled: true              # 是否启用媒体优化
  download_timeouts:
    image: 30
    video: 120
    audio: 60
    document: 60
  image:
    max_width: 1920
    max_height: 1080
    quality: 85
    output_format: webp
    ocr_backend: tesseract
    ocr_languages: [eng, chi_sim]
    caption_model: agnes-2.0-flash
    max_file_size_mb: 20.0
    caption_max_tokens: 150
    caption_temperature: 0.3
    paddleocr:
      lang: ch
      use_angle_cls: true
  video:
    max_frames: 10
    frame_interval_sec: 5.0
    scene_detection: true
    target_resolution: 720p
    max_duration_sec: 300
    whisper_model: faster-whisper
    language: auto
    max_file_size_mb: 100.0
  audio:
    target_format: opus
    sample_rate: 16000
    bitrate: 64k
    whisper_model: faster-whisper
    language: auto
    max_duration_sec: 600
    diarization_enabled: false
    max_file_size_mb: 50.0
    whisper_model_size: base
  document:
    supported_formats: [pdf, docx, xlsx, pptx, md, csv, html]
    ocr_fallback: true
    chunk_size: 512
    chunk_overlap: 64
    chunking_strategy: semantic
    embedding_model: Qwen/Qwen3-Embedding-0.6B
    vector_dim: 1024
    summary_max_length: 500
    max_file_size_mb: 50.0
    long_doc_threshold_chars: 5000
    summary_preview_chars: 2000
    unstructured:
      strategy: auto
      languages: [chi_sim, eng]
      extract_images: false
  generation:
    enhancement_level: 'off'
    vision_model: agnes-2.0-flash
    default_model: agnes-2.0-flash
    max_retries: 3
    retry_delay_ms: 1000
  media_cache_ttl: 604800    # 媒体缓存 TTL（秒）
  max_concurrent_processors: 4

# ==========================
# 生成优化层配置
# ==========================
generation_optimization:
  preset_store_dir: /app/data/generation-presets # 自定义 ComfyUI 预设 JSON 存储目录
  ai_director: {}
  model_router: {}
  feature_cache: {}
  cost_tracking: {}
  prompt_templates: {}
  token_compressor:
    clip:
      model_name: openai/clip-vit-large-patch14 # CLIP 模型
      device: cpu
      batch_size: 1
  draft_workflow:
    store_dir: /app/data/drafts # 草稿、预览和结果持久化目录
    retention_period_hours: 24 # 草稿保留时长（小时）
    comfyui:
      server_url: http://comfyui:8188 # Gateway 访问 ComfyUI 的地址
      public_url: http://localhost:8188 # 浏览器访问 ComfyUI 的地址
      manager_enabled: true
      connect_timeout: 10
      execution_timeout: 1200
      required: true
      workflow_version: image-v1
      checkpoint_name: sd_xl_base_1.0.safetensors
      allowed_checkpoints: [sd_xl_base_1.0.safetensors]
      max_concurrency: 1
      min_free_gb: 30
      model_budget_gb: 80
      output_budget_gb: 10
      output_retention_hours: 24
      models_path: /comfyui/models
      output_path: /comfyui/output
      workflow_path: /comfyui/workflows
      upscale_enabled: true
      upscale_model: RealESRGAN_x4plus.pth
      allowed_upscale_models: [RealESRGAN_x4plus.pth]
      max_upscale_long_edge: 4096
      qwen_image_enabled: true
      qwen_image_diffusion_model: qwen_image_fp8_e4m3fn.safetensors
      qwen_image_text_encoder: qwen_2.5_vl_7b_fp8_scaled.safetensors
      qwen_image_vae: qwen_image_vae.safetensors
      qwen_image_draft_steps: 12
      qwen_image_max_draft_edge: 768
      allowed_qwen_image_diffusion_models: [qwen_image_fp8_e4m3fn.safetensors]
      allowed_qwen_image_text_encoders: [qwen_2.5_vl_7b_fp8_scaled.safetensors]
      allowed_qwen_image_vaes: [qwen_image_vae.safetensors]
      video_enabled: true
      video_workflow_version: wan2.2-ti2v-5b-v1
      video_diffusion_model: wan2.2_ti2v_5B_fp16.safetensors
      video_text_encoder: umt5_xxl_fp8_e4m3fn_scaled.safetensors
      video_vae: wan2.2_vae.safetensors
      allowed_video_diffusion_models: [wan2.2_ti2v_5B_fp16.safetensors]
      allowed_video_text_encoders: [umt5_xxl_fp8_e4m3fn_scaled.safetensors]
      allowed_video_vaes: [wan2.2_vae.safetensors]
      video_width: 512
      video_height: 288
      video_frames: 17
      video_fps: 8
      video_steps: 20
      video_cfg: 5
      video_shift: 8
      video_execution_timeout: 1200

intent_classifier:
  model: agnes-2.0-flash
  timeout_seconds: 2
  fallback: heuristic
  fast_path_enabled: true
  fast_path_confidence: 0.8
  cache_ttl_seconds: 300
  cache_max_entries: 1024

model_selector:
  health_check_interval: 60
  latency_weight: 0.4
  cost_weight: 0.2
  success_rate_weight: 0.4

task_routing:
  enabled: true
  version: "2"
  min_confidence: 0.6
  model_selection_mode: policy
  expose_debug_metadata: false
  model_preferences:
    coding: [deepseek-v4-flash]
    reasoning: [deepseek-v4-flash]
    summary: [agnes-2.0-flash]
    vision: [agnes-2.0-flash]
    general: [agnes-2.0-flash]

generation:
  image:
    default_size: "1024x1024"
    response_format: url
    quality: auto
  video:
    poll_endpoint: /v1/videos/{id}
