# ============================================================
# AI Gateway — 环境变量配置模板
# ============================================================
# 用法:
#   cp .env.example .env
#   然后编辑 .env,填入你自己的 API Key
#
# 配置优先级(高 → 低):
#   1. 进程真实环境变量(docker-compose environment: 段 / shell export)
#   2. .env 文件(python-dotenv 加载,override=False 不覆盖已存在的环境变量)
#   3. config.yaml 明文值
#   4. 代码内 _DEFAULT_CONFIG 默认值
#
# 说明:
# - 以 AI_GATEWAY_ 开头的变量会由 ConfigManager 自动覆盖 config.yaml 对应路径
#   (例:AI_GATEWAY_SERVER_PORT → config.server_port)
# - config.yaml 中用 ${VAR} 或 ${VAR:-default} 引用本文件变量
#   - ${VAR}        :变量未设时保留字面量(可能导致鉴权失败)
#   - ${VAR:-}      :变量未设时降级为空字符串(优雅降级,gateway 仍能启动)
# - 不填任何 Provider Key 也能启动 gateway(插件 fail-open),
#   但调用 LLM 会鉴权失败 —— 填好 Key 后重启即可。
# ============================================================

# ===== 运行环境 =====
# production :强制 debug_mode=False、log_level≥INFO(部署到共享/生产环境必填)
# development:默认 hot_reload=True、debug_mode=True(本地开发)
AI_GATEWAY_ENV=development

# ===== 基础设施连接(config.yaml 已用 ${VAR:-default} 引用)=====
# Docker Compose 部署时会被 environment: 段覆盖为容器网络地址,无需改动
AI_GATEWAY_REDIS_URL=redis://localhost:6379/0
AI_GATEWAY_QDRANT_URL=http://localhost:6333
COMFYUI_VERSION=v0.28.0
COMFYUI_HOST_BIND=127.0.0.1
COMFYUI_HOST_PORT=8188

# ===== Provider API Keys =====
# 注册地址(开源用户按需申请,填入对应 key):
#   Agnes    :https://agnes-ai.com        (多模态理解 + 图片/视频生成)
#   DeepSeek :https://platform.deepseek.com (纯文本 LLM,注册送额度)
#
# 不用的 provider 可留空(config.yaml 用 ${VAR:-} 降级,该 provider 鉴权会失败但不影响其他功能)
AGNES_API_KEY=
DEEPSEEK_API_KEY=

# ===== 控制台管理员与浏览器 Session =====
# 控制台只支持用户名 + 密码登录；API Key 不再作为控制台登录凭据。
# 新装实例应由安装器生成一次性初始密码：
#   AI_GATEWAY_INITIAL_ADMIN_PASSWORD=<installer-generated-temporary-password>
# 登录页在 AI_GATEWAY_PREFILL_INITIAL_CREDENTIALS=true 时自动填入用户名和初始密码；
# 首次登录后会强制设置独立管理员密码，并从 .env 中移除这个一次性密码。
#
# AI_GATEWAY_ADMIN_USERNAME=admin
# AI_GATEWAY_INITIAL_ADMIN_PASSWORD=
# AI_GATEWAY_PREFILL_INITIAL_CREDENTIALS=false
# AI_GATEWAY_SESSION_TTL_SECONDS=28800
# AI_GATEWAY_SESSION_ABSOLUTE_TTL_SECONDS=86400
# AI_GATEWAY_PASSWORD_PBKDF2_ITERATIONS=600000
#
# 默认不信任 X-Forwarded-For / X-Forwarded-Proto，避免客户端伪造审计 IP 或 HTTPS 状态。
# 位于反向代理后时，推荐只列出可信代理 IP；确需全信任时才启用 TRUST_PROXY_HEADERS。
# AI_GATEWAY_TRUSTED_PROXY_IPS=127.0.0.1,::1
# AI_GATEWAY_TRUST_PROXY_HEADERS=false

# ===== 内部网关 API Key =====
# ADMIN_API_KEY 仅用于程序化 API 调用，不参与控制台登录，也不会写入浏览器 Cookie。
ADMIN_API_KEY=

# 控制台 /chat 页不会把 API Key 下发到浏览器。后端会用此服务端 Key 进入 dispatcher，
# 使控制台聊天仍走 key_hash 维度的配额检查和成本账本。留空则回退使用 ADMIN_API_KEY。
# AI_GATEWAY_CONSOLE_CHAT_API_KEY=

# 对话压缩插件(conv_compressor)默认让摘要 LLM 走 gateway 自身(agnes-2.0-flash),
# 避免依赖外部 OPENAI_API_KEY。此处填一个本网关签发的 API Key(在 config.yaml auth.api_keys 中定义)。
# 留空则对话压缩降级为 passthrough(不影响主流程)。
CONV_COMPRESSOR_API_KEY=

# ===== 服务端口(可选,缺省走 config.yaml)=====
# AI_GATEWAY_SERVER_HOST=0.0.0.0
# AI_GATEWAY_SERVER_PORT=8000

# ===== 可观测性(可选)=====
# AI_GATEWAY_OBSERVABILITY_LOG_LEVEL=info
# AI_GATEWAY_OBSERVABILITY_LOG_FORMAT=json

# ===== 配置文件路径(可选,缺省自动搜索 ./config.yaml)=====
# AI_GATEWAY_CONFIG_PATH=./config.yaml

# ComfyUI 0.28 的 Dynamic VRAM 在部分 NVIDIA/CUDA 组合上会误报 OOM。
# 默认关闭；确认当前版本和硬件稳定后，可设为 false 重新启用。
# COMFYUI_DISABLE_DYNAMIC_VRAM=true
# Grafana requires an explicit non-default admin password.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
